{
  "_comment": "Claude Desktop config. Both entries use `npx -y blastradius-mcp` so nothing breaks when you move machines. Set a stable signing key in production so approval tokens and audit chains survive a restart.",
  "mcpServers": {
    "blastradius-security": {
      "command": "npx",
      "args": [
        "-y",
        "blastradius-mcp"
      ],
      "env": {
        "BLAST_RADIUS_SIGNING_KEY": "replace-with-a-long-random-secret",
        "BLAST_RADIUS_AUDIT_KEY": "replace-with-a-different-long-random-secret"
      }
    },
    "guarded-filesystem-proxy": {
      "command": "npx",
      "args": [
        "-y",
        "blastradius-mcp",
        "proxy",
        "--command",
        "npx -y @modelcontextprotocol/server-filesystem /workspace"
      ],
      "env": {
        "BLAST_RADIUS_SIGNING_KEY": "replace-with-a-long-random-secret"
      }
    }
  }
}
